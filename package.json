{
  "name": "analyze-video-mcp",
  "version": "0.6.1",
  "description": "MCP server that lets local agents analyze video picture and embedded audio",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "qwen",
    "dashscope",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JaylanJerry/analyze-video-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaylanJerry/analyze-video-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "analyze-video-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/prepare.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:install": "tsx scripts/install-e2e.ts",
    "test:pack-install": "tsx scripts/pack-install-e2e.ts",
    "test:npx-github": "tsx scripts/npx-github-e2e.ts",
    "coverage": "vitest run --coverage",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "msw": "^2.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
