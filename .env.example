# Optional env file (same as --config). Not loaded from the process cwd.
# QWEN_CONFIG_FILE=

# Tests set this to 1 so a developer machine's user env cannot hide a missing Key.
# QWEN_DISABLE_CONFIG_FALLBACKS=

# Bailian (DashScope) API key. REQUIRED to call the tool. Never commit the real value.
DASHSCOPE_API_KEY=

# Internal model id. Not part of the Agent tool schema.
# Default: qwen3.8-omni-flash (omni tier, reads picture + embedded audio).
QWEN_MODEL=qwen3.8-omni-flash

# OpenAI-compatible inference endpoint. HTTPS only.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Temporary upload policy endpoint. HTTPS only. Beijing region.
DASHSCOPE_UPLOAD_URL=https://dashscope.aliyuncs.com/api/v1/uploads

# Required for local MP4/MOV/MP3. Absolute directories the server may read.
# Separate with the platform path delimiter (; on Windows). Empty = HTTPS only.
MEDIA_ALLOWED_ROOTS=

# Upload any local media path an Agent names, without a roots check. Default off.
# Turning it on makes the path itself the authorization, so any file the Agent
# writes can be uploaded to Bailian. See docs/decisions/0021-allow-any-local-video-opt-in.md
# MEDIA_ALLOW_ANY_LOCAL_FILE=on

# Default on. Set off to disable reuse of temporary oss:// URLs.
QWEN_UPLOAD_CACHE=on

# Local file policy cap in MiB. Must be 1-1024. Actual upload also respects the live policy.
MEDIA_MAX_LOCAL_MEDIA_MB=1024

# Upload and analysis timeouts in seconds. Must be 1-3600.
QWEN_UPLOAD_TIMEOUT=900
QWEN_ANALYSIS_TIMEOUT=900

# Retries before the first analysis byte. Only 0 or 1.
QWEN_ANALYSIS_RETRIES=1

# --- Migrating from a pre-analyze_media install --------------------------------
# These older names are IGNORED and reported by --doctor; nothing is granted by them:
#   QWEN_ALLOWED_ROOTS         -> MEDIA_ALLOWED_ROOTS
#   QWEN_ALLOW_ANY_LOCAL_VIDEO -> MEDIA_ALLOW_ANY_LOCAL_FILE
#   QWEN_MAX_LOCAL_VIDEO_MB    -> MEDIA_MAX_LOCAL_MEDIA_MB
#   QWEN_AUDIO_SILENCE_CHECK   -> removed (the optional FFmpeg silence check is gone)
