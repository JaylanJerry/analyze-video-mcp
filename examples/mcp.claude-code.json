{
  "mcpServers": {
    "analyze_video_mcp": {
      "command": "npx",
      "args": ["-y", "--prefer-offline", "analyze-video-mcp@1.0.0"],
      "env": {
        "DASHSCOPE_API_KEY": "YOUR_DASHSCOPE_API_KEY",
        "QWEN_MODEL": "qwen3.8-omni-flash",
        "MEDIA_ALLOWED_ROOTS": "C:\\Users\\用户名\\Videos"
      }
    }
  }
}
