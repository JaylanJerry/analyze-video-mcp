# Bailian (DashScope) API key. REQUIRED. Never commit the real value.
DASHSCOPE_API_KEY=

# Internal model id. Not part of the Agent tool schema.
QWEN_MODEL=qwen3.5-omni-flash

# Leftover until the extra media tools are removed in T06.
QWEN_OMNI_MODEL=qwen3.5-omni-plus

# OpenAI-compatible inference endpoint. HTTPS only.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Temporary upload policy endpoint. HTTPS only. Beijing region.
DASHSCOPE_UPLOAD_URL=https://dashscope.aliyuncs.com/api/v1/uploads

# Absolute directories the server may read local MP4s from.
# Separate with the platform path delimiter (; on Windows). Empty = deny all local paths.
QWEN_ALLOWED_ROOTS=

# Local file policy cap in MiB. Must be 1-1024. Actual upload also respects the live policy.
QWEN_MAX_LOCAL_VIDEO_MB=1024

# Upload and analysis timeouts in seconds. Must be 1-3600.
QWEN_UPLOAD_TIMEOUT=900
QWEN_ANALYSIS_TIMEOUT=900

# Retries before the first analysis byte. Only 0 or 1.
QWEN_ANALYSIS_RETRIES=1
